{
  "name": "@discere-os/glib.wasm",
  "version": "2.78.1-alpha.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "description": "WASM-native GLib with advanced browser integration",
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.js",
  "types": "dist/lib/types.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/lib/index.js",
      "node": "./dist/lib/index.js",
      "types": "./dist/lib/types.d.ts"
    },
    "./side": {
      "import": "./install/wasm/glib-side.wasm",
      "types": "./dist/lib/types.d.ts"
    },
    "./main": {
      "import": "./install/wasm/glib-release.js",
      "types": "./dist/lib/types.d.ts"
    },
    "./fallback": {
      "import": "./install/wasm/glib-fallback.js",
      "types": "./dist/lib/types.d.ts"
    }
  },
  "files": [
    "dist/",
    "install/",
    "src/",
    "build-dual.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project . --skipLibCheck && ./build-dual.sh all && mkdir -p build && cp install/wasm/* build/",
    "build:wasm": "./build-dual.sh all",
    "build:docs": "typedoc src/lib/index.ts --out docs/api",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --project . --noEmit --skipLibCheck",
    "demo": "node dist/demo.js",
    "benchmark": "node dist/benchmark.js",
    "clean": "./build-dual.sh clean && rm -rf node_modules/.vite",
    "prepublishOnly": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.35.0",
    "happy-dom": "^18.0.1",
    "typedoc": "^0.28.12",
    "typescript": "^5.3.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discere-os/glib.wasm.git"
  },
  "author": "Superstruct Ltd, New Zealand",
  "license": "LGPL-2.1-or-later",
  "keywords": [
    "glib",
    "webassembly",
    "wasm",
    "browser",
    "native",
    "gtk",
    "gobject",
    "threading",
    "filesystem",
    "networking",
    "opfs",
    "webgpu",
    "sharedArrayBuffer"
  ],
  "homepage": "https://github.com/discere-os/glib.wasm",
  "bugs": {
    "url": "https://github.com/discere-os/glib.wasm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/discere-os"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "cdn": {
    "primary": "https://wasm.discere.cloud/glib/",
    "fallbacks": [
      "https://cdn.jsdelivr.net/npm/@discere-os/glib.wasm/",
      "https://unpkg.com/@discere-os/glib.wasm/"
    ]
  }
}